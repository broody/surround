# KataGo for the AI regulars: the stack (offchain/anchors/stack.ts) reads these.
KATAGO_BIN=/path/to/katago
KATAGO_MODEL=/path/to/kata1-b18c384nbt.bin.gz
KATAGO_HUMAN_MODEL=/path/to/b18c384nbt-humanv0.bin.gz
# KATAGO_ANALYSIS_CONFIG=/path/to/analysis.cfg
# The PROOF2 build of arbiter's prover, for the stack's gateway (default: ~/.cache/arbiter-prover)
# ARBITER_PROVER_BUILD=/path/to/arbiter-prover
# The matchmaker for rated play on Starknet (default: offchain/anchors/stack.ts's)
# MATCHMAKER_URL=http://127.0.0.1:3300
# The ratings contract a build trusts: tickets for another are never signed
# (default: the matchmaker's, from its /info)
# VITE_RATINGS_ADDRESS=0x...
# The Outis window, where a player with no Outis extension signs in with an email
# (default: https://account.outis.xyz, which answers surround.gg only; a local one
# lists this app's origin through its own VITE_OUTIS_DEV_SURROUND)
# VITE_OUTIS_WINDOW_URL=http://127.0.0.1:5194
# The documentation site linked from the landing header (default: docs.surround.gg)
# VITE_DOCS_URL=https://docs.surround.gg
